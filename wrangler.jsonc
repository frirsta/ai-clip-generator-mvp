{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "ai-clip-generator-mvp",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ai-clip-generator-mvp"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "ai-clip-generator-mvp-opennext-cache"
    },
    {
      "binding": "VIDEO_BUCKET",
      "bucket_name": "ai-clip-videos"
    }
  ],
  "ai": {
  "binding": "AI"
},
"media": {
  "binding": "MEDIA"
},
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}